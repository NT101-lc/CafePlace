# Production settings, read by deploy/docker-compose.yml.
# Copy to deploy/.env and fill in real values:  cp .env.example deploy/.env
# Never commit the real .env.
#
# Local development needs NO env file: the dev profile defaults match docker-compose.dev.yml.

# Public domain pointing to the server. Caddy gets the HTTPS certificate for it.
# Use "localhost" to try the production stack on your own machine.
DOMAIN=quan.example.com

# PostgreSQL
DB_NAME=cms
DB_USERNAME=cms
DB_PASSWORD=change-me-strong-password

# JWT signing key, at least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-generate-a-long-random-secret
# Token lifetime (Spring Boot duration format: 12h, 7d, ...)
JWT_TTL=7d

# RustFS (S3-compatible storage for menu images). Choose your own keys; RustFS is created with them.
# Generate with:  openssl rand -hex 16   (access key)  /  openssl rand -base64 32   (secret key)
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key-at-least-8-chars
# Bucket name (created automatically by the backend)
S3_BUCKET=cms-media
